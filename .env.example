# Resend (https://resend.com) — used by the contact form to send email.
# Create an API key at https://resend.com/api-keys and paste it below.
RESEND_API_KEY=

# Where contact form submissions are sent. Defaults to info@lwar.group if unset.
CONTACT_TO_EMAIL=info@lwar.group

# The "From" address Resend sends as. Until you verify a sending domain in
# Resend, this must stay onboarding@resend.dev (Resend's shared test address,
# which only delivers to the email you signed up to Resend with). Once you
# verify lwar.group in the Resend dashboard, switch this to an address on
# that domain, e.g. "LWAR Companies <hello@lwar.group>".
CONTACT_FROM_EMAIL=LWAR Companies Website <onboarding@resend.dev>
